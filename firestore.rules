// Reading Mate — Firestore security rules (Milestone 2)
//
// To apply these: Firebase console -> your project -> Build -> Firestore
// Database -> Rules tab -> paste this in -> Publish.
//
// Scopes every document under users/{uid} (profile, sessions, progress) to
// that one signed-in user — nobody can read or write another account's
// data, even though everything lives in one Firestore database.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
